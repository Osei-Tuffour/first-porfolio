# Environment Configuration
# Database Configuration
DB_HOST=localhost
DB_NAME=voting_system
DB_USER=root
DB_PASS=
DB_PORT=3306

# Application Configuration
APP_NAME=Voting System
APP_URL=http://localhost
APP_ENV=development
APP_DEBUG=true

# Security Configuration
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-encryption-key-here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_ENCRYPTION=tls

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf
UPLOAD_PATH=Src/Frontend/Uploads/

# Session Configuration
SESSION_TIMEOUT=3600
SESSION_NAME=voting_session

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=100
API_TIMEOUT=30

# Social Login Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Admin Configuration
ADMIN_EMAIL=admin@votingsystem.com
ADMIN_PASSWORD_HASH=$2y$10$8K1p/kVGKpDH0WJ8XP5MWeKjINhQXr6TRN8rDv5X7GRosF1Kq/hdi

# Logging Configuration
LOG_LEVEL=debug
LOG_PATH=logs/
LOG_ROTATION=daily

# Cache Configuration
CACHE_DRIVER=file
CACHE_PREFIX=voting_
CACHE_TTL=3600

# Queue Configuration
QUEUE_DRIVER=database
QUEUE_CONNECTION=redis
QUEUE_TIMEOUT=60
